{
  "eslint": {
    "stage1": {
      "rules": {
        "no-debugger": "error",
        "no-duplicate-imports": "error"
      }
    },
    "noisy": {
      "rules": {
        "curly": "error",
        "eqeqeq": "error"
      }
    },
    "stage2": {
      "rules": {
        "no-implicit-coercion": "error",
        "no-nested-ternary": "error",
        "consistent-return": "error",
        "default-case": "error"
      }
    },
    "stage3": {
      "files": [
        "frontend/**/*.{js,jsx,ts,tsx,mjs,mts}"
      ],
      "rules": {
        "solid/reactivity": "error",
        "solid/no-destructure": "error",
        "solid/components-return-once": "error",
        "solid/no-react-deps": "error",
        "solid/no-react-specific-props": "error",
        "solid/prefer-for": "error",
        "solid/style-prop": "error",
        "solid/event-handlers": "error",
        "solid/no-accessor-as-prop": "error",
        "solid/prefer-classlist": "error",
        "solid/no-unused-signal": "error",
        "solid/no-write-in-pure-computation": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "solid-js",
                "importNames": [
                  "untrack",
                  "createRoot",
                  "runWithOwner"
                ],
                "message": "Reactive escape hatch: review tracking/ownership and disposal; document justified use with a narrow suppression."
              },
              {
                "name": "solid-js/store",
                "importNames": [
                  "createMutable"
                ],
                "message": "Mutable-store escape hatch: review direct mutation; document justified use with a narrow suppression."
              }
            ]
          }
        ]
      }
    }
  },
  "groups": [
    [
      "npm:build",
      "npm:lint",
      "npm:test"
    ],
    [
      "eslint:stage1"
    ],
    [
      "eslint:stage2"
    ],
    [
      "eslint:stage3"
    ],
    [
      "eslint:noisy"
    ]
  ],
  "policies": {
    "ast-grep-no-clear-interval": "off",
    "ast-grep-no-discarded-router-navigation": "off",
    "ast-grep-no-dynamic-code": "off",
    "ast-grep-no-sanitization-bypass": "off",
    "ast-grep-no-subscribe": "off",
    "npm:build": "agent",
    "eslint:stage1": "agent",
    "eslint:noisy": "off",
    "eslint:stage2": "user",
    "eslint:stage3": "user",
    "npm:lint": "agent",
    "never-applicable": "off",
    "stryker-mutation": "off",
    "npm:test": "agent",
    "typescript-empty-lines": "off",
    "vitest-coverage": "off"
  },
  "removed": [
    "vitest-coverage",
    "typescript-empty-lines",
    "stryker-mutation",
    "never-applicable",
    "ast-grep-no-subscribe",
    "ast-grep-no-sanitization-bypass",
    "ast-grep-no-dynamic-code",
    "ast-grep-no-discarded-router-navigation",
    "ast-grep-no-clear-interval"
  ],
  "options": {
    "useNix": false
  },
  "configs": {
    "stryker-mutation": {
      "minMutationScore": 80
    },
    "typescript-empty-lines": {
      "minEmptyLineRatio": 0.05
    },
    "vitest-coverage": {
      "minLineCoverage": 80
    }
  }
}
