{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.dev/schemas/settings.schema.json",
  "$comment": "This file is generated from TypeScript source. Do not edit it manually; run npm run generate:schemas.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference."
    },
    "defaultProvider": {
      "type": "string"
    },
    "defaultModel": {
      "type": "string"
    },
    "defaultThinkingLevel": {
      "$ref": "#/$defs/ModelThinkingLevel"
    },
    "modelThinkingLevels": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "$ref": "#/$defs/ModelThinkingLevel"
        }
      },
      "description": "Per-model default thinking level overrides keyed by \"provider/modelId\"."
    },
    "transport": {
      "anyOf": [
        {
          "type": "string",
          "const": "auto"
        },
        {
          "type": "string",
          "const": "sse"
        },
        {
          "type": "string",
          "const": "websocket"
        },
        {
          "type": "string",
          "const": "websocket-cached"
        }
      ],
      "default": "auto"
    },
    "steeringMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "all"
        },
        {
          "type": "string",
          "const": "one-at-a-time"
        }
      ],
      "default": "one-at-a-time"
    },
    "followUpMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "all"
        },
        {
          "type": "string",
          "const": "one-at-a-time"
        }
      ],
      "default": "one-at-a-time"
    },
    "compaction": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "reserveTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 16384
        },
        "keepRecentTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 20000
        },
        "modelOverrides": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "object",
              "properties": {
                "reserveTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "keepRecentTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          },
          "description": "Per-model overrides keyed by exact \"provider/modelId\" strings."
        }
      }
    },
    "branchSummary": {
      "type": "object",
      "properties": {
        "reserveTokens": {
          "type": "number",
          "description": "Tokens reserved for the prompt and LLM response.",
          "default": 16384
        },
        "skipPrompt": {
          "type": "boolean",
          "description": "When true, skips the \"Summarize branch?\" prompt and defaults to no summary.",
          "default": false
        }
      }
    },
    "retry": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "maxRetries": {
          "type": "number",
          "default": 3
        },
        "baseDelayMs": {
          "type": "number",
          "description": "Exponential backoff base delay in milliseconds: 2s, 4s, 8s.",
          "default": 2000
        },
        "maxAgentDelayMs": {
          "type": "number",
          "default": 60000
        },
        "provider": {
          "type": "object",
          "properties": {
            "timeoutMs": {
              "type": "number",
              "description": "SDK or provider request timeout in milliseconds."
            },
            "maxRetries": {
              "type": "number",
              "description": "SDK or provider retry attempts."
            },
            "maxRetryDelayMs": {
              "type": "number",
              "description": "Maximum server-requested delay before failing.",
              "default": 60000
            }
          }
        },
        "maxDelayMs": {
          "type": "number",
          "description": "Legacy retry delay setting. Use provider.maxRetryDelayMs instead.",
          "deprecated": true
        }
      }
    },
    "shellPath": {
      "type": "string",
      "description": "Custom shell path with support for leading ~ expansion."
    },
    "defaultProjectTrust": {
      "anyOf": [
        {
          "type": "string",
          "const": "ask"
        },
        {
          "type": "string",
          "const": "always"
        },
        {
          "type": "string",
          "const": "never"
        }
      ],
      "description": "Global setting only.",
      "default": "ask"
    },
    "shellCommandPrefix": {
      "type": "string",
      "description": "Prefix prepended to every bash command, for example to enable shell aliases."
    },
    "npmCommand": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Command used for npm package lookup and installation, in argv form such as [\"mise\", \"exec\", \"node@20\", \"--\", \"npm\"]."
    },
    "packages": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "description": "Load all resources from the package."
          },
          {
            "type": "object",
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "autoload": {
                "type": "boolean",
                "description": "When false, start empty and only apply explicit resource patterns."
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "prompts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "description": "Package source for npm or git packages. Use the string form to load all resources or the object form to filter resources."
      },
      "description": "npm or git package sources, as strings or objects with resource filtering."
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Local extension file paths or directories."
    },
    "deviceId": {
      "type": "string",
      "description": "Stable installation UUID, generated when authentication first needs it. Global only."
    },
    "skills": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "properties": {
            "enableSkillCommands": {
              "type": "boolean"
            },
            "customDirectories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "deprecated": true
        }
      ],
      "description": "Local skill file paths or directories."
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Local prompt template file paths or directories."
    },
    "enableSkillCommands": {
      "type": "boolean",
      "description": "Register skills as /skill:name commands.",
      "default": true
    },
    "images": {
      "type": "object",
      "properties": {
        "autoResize": {
          "type": "boolean",
          "description": "Resize images to 2000x2000 maximum for better model compatibility.",
          "default": true
        },
        "blockImages": {
          "type": "boolean",
          "description": "When true, prevents all images from being sent to LLM providers.",
          "default": false
        }
      }
    },
    "enabledModels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Model patterns for cycling, in the same format as the --models CLI flag."
    },
    "defaultTools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Initial tool selection. Plain names replace the inherited selection; +name and -name entries add or remove tools."
    },
    "thinkingBudgets": {
      "type": "object",
      "properties": {
        "minimal": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "medium": {
          "type": "number"
        },
        "high": {
          "type": "number"
        }
      },
      "description": "Custom token budgets for thinking levels."
    },
    "codemode": {
      "type": "object",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "const": "on"
            },
            {
              "type": "string",
              "const": "only"
            }
          ],
          "description": "How codemode presents tools. \"on\" keeps direct tools declared and annotates tools callable from scripts; codemode lists only tools without direct exposure. \"only\" lists every script-callable tool in codemode and does not declare active direct tools.",
          "default": "on"
        },
        "inlineBudget": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated tokens available for inline codemode tool declarations.",
          "default": 3000
        }
      }
    },
    "sessionDir": {
      "type": "string",
      "description": "Custom session storage directory, in the same format as the --session-dir CLI flag."
    },
    "httpProxy": {
      "type": "string",
      "description": "Proxy URL applied as HTTP_PROXY and HTTPS_PROXY for Pi-managed HTTP clients."
    },
    "httpIdleTimeoutMs": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "const": "disabled"
        }
      ],
      "description": "HTTP header or body idle timeout in milliseconds; 0 or \"disabled\" disables it."
    },
    "cacheWarming": {
      "anyOf": [
        {
          "type": "string",
          "const": "off"
        },
        {
          "type": "string",
          "const": "streaming"
        },
        {
          "type": "string",
          "const": "idle"
        }
      ],
      "description": "Cache-warming profile. \"idle\" also warms between agent runs. Global only because each refresh costs money.",
      "default": "streaming"
    },
    "websocketConnectTimeoutMs": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "const": "disabled"
        }
      ],
      "description": "WebSocket connect or open handshake timeout in milliseconds; 0 or \"disabled\" disables it."
    },
    "queueMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "all"
        },
        {
          "type": "string",
          "const": "one-at-a-time"
        }
      ],
      "description": "Legacy setting migrated to steeringMode.",
      "deprecated": true
    },
    "websockets": {
      "type": "boolean",
      "description": "Legacy setting migrated to transport.",
      "deprecated": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "ModelThinkingLevel": {
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    }
  }
}
